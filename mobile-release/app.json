{
  "expo": {
    "name": "Qbit",
    "slug": "weekly-tax-app-release",
    "description": "Compliance-focused weekly tax tracking for self-employed vehicle movement drivers.",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#f5ede1",
    "scheme": "weeklytaxapp",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.aplc.weeklytaxapp",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aplc.weeklytaxapp",
      "versionCode": 1,
      "targetSdkVersion": 36,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5ede1"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000",
      "eas": {
        "projectId": "bc53ec71-b7cf-409a-a964-45fde4b5de75"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Qbit to access your camera so you can photograph receipts.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "pavak01"
  }
}
